<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos Bluetooth estándar (100% sin Root ni Shizuku) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Feedback háptico One UI al pulsar botones en el widget -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Servicio bajo demanda para sincronización y comunicación estable RFCOMM -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:name=".NuclearSoundApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NuclearSoundConnect">

        <!-- Actividad Principal: Diagnóstico, Monitor RFCOMM y Configuración -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NuclearSoundConnect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad de Configuración y Personalización del Widget (Pulsación Larga -> Ajustes) -->
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.NuclearWearable.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Receptor 1: Widget Dúo / Combinado (Batería + Control de Ruido 4x2) -->
        <receiver
            android:name=".widget.SonyBudsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.BATTERY_LEVEL_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.nuclear.soundconnect.ACTION_REFRESH" />
                <action android:name="com.nuclear.soundconnect.ACTION_SET_ANC" />
                <action android:name="com.nuclear.soundconnect.ACTION_SET_OFF" />
                <action android:name="com.nuclear.soundconnect.ACTION_SET_AMBIENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sony_buds_widget_info" />
        </receiver>

        <!-- Receptor 2: Widget Solo Batería (Anillos de Carga y Siluetas) -->
        <receiver
            android:name=".widget.NuclearBatteryWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.BATTERY_LEVEL_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.nuclear.soundconnect.ACTION_BATTERY_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nuclear_battery_widget_info" />
        </receiver>

        <!-- Receptor 3: Widget Solo Control de Ruido (Barra Píldora ANC / Off / Ambiente) -->
        <receiver
            android:name=".widget.NuclearNoiseWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.nuclear.soundconnect.ACTION_NOISE_ANC" />
                <action android:name="com.nuclear.soundconnect.ACTION_NOISE_OFF" />
                <action android:name="com.nuclear.soundconnect.ACTION_NOISE_AMBIENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nuclear_noise_widget_info" />
        </receiver>

        <!-- Foreground Service ligero para operaciones de RFCOMM sin congelar el hilo principal -->
        <service
            android:name=".bluetooth.SonyForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Servicio Wearable Data Layer para comunicación bidireccional con Wear OS -->
        <service
            android:name=".wear.NuclearPhoneWearableService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/nuclear" />
            </intent-filter>
        </service>

    </application>

</manifest>
