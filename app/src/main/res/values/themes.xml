<resources>
    <!-- Base application theme -->
    <style name="Theme.NuclearSoundConnect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#121214</item>
        <item name="android:navigationBarColor">#121214</item>
        <item name="android:windowBackground">#121214</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.NuclearWearable.WidgetConfig" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
